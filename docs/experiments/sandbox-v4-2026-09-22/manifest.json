          "kind": "source",
          "artifact": {
            "source": "import math\n\ndef decide(view):\n    # Diagnosis: Prior policy wasted an empty round by expanding completed leaves and relying on stale frontier state.\n    # Replay reveals no new evidence for expanded leaves, causing redundant probes.\n    # Changes: 1) Filter frontier to unexpanded leaves to prevent expanding already-expanded nodes.\n    # 2) Explicitly stop on empty last_round to cut wasted rounds early.\n    # 3) Use robust UCB with best_score fallback, handling null scores correctly.\n    # 4) Track root expansion via history to avoid redundant re-attempts.\n    \n    frontier = view['frontier']\n    if not frontier:\n        return {'expand': [], 'stop': True}\n        \n    if view.get('last_round') and not view['last_round'].get('revealed_nodes'):\n        return {'expand': [], 'stop': True}\n        \n    # Focus on unexpanded leaves to avoid wasting rounds on completed nodes\n    candidates = [n for n in frontier if n.get('children_count', 0) == 0]\n    if not candidates:\n        return {'expand': [], 'stop': True}\n        \n    history_ids = [h.get('id') for h in view.get('history', [])]\n    root_id = frontier[0]['id']\n    root_expanded = root_id in history_ids\n    \n    total_visits = sum([n.get('children_count', 0) for n in frontier]) + len(frontier)\n    if total_visits <= 1:\n        total_visits = 2\n        \n    def priority(node):\n        if node.get('depth', 0) == 0 and root_expanded:\n            return -200.0\n        score = node.get('score')\n        if score is None:\n            score = view.get('best_score') or 0.0\n        visits = node.get('children_count', 0) + 1\n        if visits <= 0:\n            visits = 1\n        return score + 1.41 * math.sqrt(math.log(total_visits) / visits)\n        \n    ranked = sorted(candidates, key=priority, reverse=True)\n    return {'expand': [n['id'] for n in ranked[:2]], 'stop': False}",
