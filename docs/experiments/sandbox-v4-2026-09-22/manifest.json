            "source": "import math\n\ndef decide(view):\n    frontier = view[\"frontier\"]\n    if not frontier:\n        return {\"expand\": [], \"stop\": True}\n    \n    # Calculate total potential visits across the frontier\n    total_visits = sum([node[\"children_count\"] + 1 for node in frontier])\n    if total_visits == 0:\n        total_visits = 1\n    \n    def priority(node):\n        score = node[\"score\"]\n        if score is None:\n            score = view[\"best_score\"] or 0.0\n        visits = node[\"children_count\"] + 1\n        if visits <= 0:\n            visits = 1\n        # Reduce exploration coefficient over time to favor exploitation\n        # Use a smaller coefficient for deeper nodes to prioritize refinement\n        depth_factor = max(0.5, 1.0 - node.get(\"depth\", 0) * 0.1)\n        return score + depth_factor * math.sqrt(math.log(total_visits) / visits)\n    \n    # Filter out the root node after first expansion to avoid redundant probing\n    # Root is identified by parent_id being None\n    non_root_frontier = [node for node in frontier if node.get(\"parent_id\") is not None]\n    \n    if not non_root_frontier:\n        # Only root exists, expand it once to get feedback\n        return {\"expand\": [node[\"id\"] for node in frontier[:1]], \"stop\": False}\n    \n    # Sort and select top nodes based on priority\n    ranked = sorted(non_root_frontier, key=priority, reverse=True)\n    \n    # Limit batch size based on available budget and rounds to optimize mean score\n    # Use a dynamic batch size that decreases as rounds increase\n    rounds_used = view.get(\"rounds_used\", 1)\n    batch_size = max(1, min(4, 8 // rounds_used))\n    \n    return {\"expand\": [node[\"id\"] for node in ranked[:batch_size]], \"stop\": False}",
